@startuml
title AgroTech Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(FitLifeSystem, "Система AgroTech") {
  Container(WebApp, "Web Application", "Java, Spring", "Обработка данных с фермы")
  Container(Database, "Database", "PostgreSQL", "Хранение данных с фермы")
}

Container(WebApp, "Web Application", "Java, Spring") {
  Component(AuthController, "AuthController", "Обработка авторизации и аутентификации")
  Component(UserController, "UserController", "Кабинет пользователя")

  Component(ServiceLayer, "Service Layer", "Бизнес логика")
  Component(RepositoryLayer, "Repository Layer", "Доступ к данным")
}

Rel(AuthController,ServiceLayer,"Calls business logic")
Rel(UserController,ServiceLayer,"Calls business logic")
Rel(ServiceLayer,RepositoryLayer,"Reads/Writes data")
Rel(RepositoryLayer,Database,"Reads/Writes user data")
@enduml