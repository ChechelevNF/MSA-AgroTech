@startuml
title AgroTech Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

System_Ext(Agent, "RabbitMQ", "Очередь для отправки аллертов агенту фермы")

Container_Boundary(FitLifeSystem, "Система AgroTech") {
  Container(CentralServer, "Центральный сервер", "Java, Spring", "Обработка данных с фермы")
  Container(Database, "Database", "PostgreSQL", "Хранение данных с фермы")
}

Container(CentralServer, "Центральный сервер", "Java, Spring") {
  Component(AuthController, "AuthController", "Обработка авторизации и аутентификации")

  Component(ServiceLayer, "Service Layer", "Бизнес логика")
  Component(RepositoryLayer, "Repository Layer", "Доступ к данным")
}

Rel(AuthController,ServiceLayer,"Вызов бизнес логики")
Rel(ServiceLayer,RepositoryLayer,"Чтение запись данных")
Rel(RepositoryLayer,Database,"Чтение запись данных")
Rel(ServiceLayer, Agent, "Отправка сообщений")
@enduml